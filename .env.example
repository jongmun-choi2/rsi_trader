# 토스증권 Open API 키 설정 (.env)
# WTS 설정 > Open API 메뉴에서 발급받은 키를 입력하세요.
TOSS_CLIENT_ID=your_client_id_here
TOSS_CLIENT_SECRET=your_client_secret_here

# 텔레그램 봇 알림 설정 (만료 없음, 권장)
# @BotFather 에게 /newbot 으로 생성 후 발급받은 토큰
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_or_empty
